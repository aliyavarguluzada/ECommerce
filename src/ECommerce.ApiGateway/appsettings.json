{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/identity/{**rest}"
        }
      },
      "products": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/products/{**rest}"
        }
      },
      "categories": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/categories/{**rest}"
        }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/api/inventory/{**rest}"
        }
      },
      "orders": {
        "ClusterId": "order",
        "AuthorizationPolicy": "Customer",
        "Match": {
          "Path": "/api/orders/{**rest}"
        }
      },
      "cart": {
        "ClusterId": "cart",
        "AuthorizationPolicy": "Customer",
        "Match": {
          "Path": "/api/cart/{**rest}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "Customer",
        "Match": {
          "Path": "/api/payments/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5174/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5171/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5172/"
          }
        }
      },
      "order": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5173/"
          }
        }
      },
      "cart": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5175/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5176/"
          }
        }
      }
    }
  }
}
