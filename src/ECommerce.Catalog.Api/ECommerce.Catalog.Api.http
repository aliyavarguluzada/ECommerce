@host = http://localhost:5171
@categoryId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000

### Create a category; copy the returned ID into categoryId.
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Electronics", "description": "Devices and accessories" }

### List categories.
GET {{host}}/api/categories

### Category details.
GET {{host}}/api/categories/{{categoryId}}

### Update category.
PUT {{host}}/api/categories/{{categoryId}}
Content-Type: application/json

{ "name": "Electronics", "description": "Updated devices and accessories" }

### Create a product; copy the returned ID into productId.
POST {{host}}/api/products
Content-Type: application/json

{
  "name": "Wireless mouse",
  "description": "Wireless productivity mouse",
  "price": 99.99,
  "currency": "USD",
  "categoryId": "{{categoryId}}"
}

### Product details.
GET {{host}}/api/products/{{productId}}

### Active products with category, search, and pagination.
GET {{host}}/api/products?pageNumber=1&pageSize=20&categoryId={{categoryId}}&search=mouse

### Update product.
PUT {{host}}/api/products/{{productId}}
Content-Type: application/json

{
  "name": "Wireless mouse",
  "description": "Updated description",
  "price": 89.99,
  "currency": "USD",
  "categoryId": "{{categoryId}}"
}

### Change price.
PATCH {{host}}/api/products/{{productId}}/price
Content-Type: application/json

{ "price": 79.99, "currency": "USD" }

### Discontinue product; it remains accessible by ID.
DELETE {{host}}/api/products/{{productId}}

### List discontinued products.
GET {{host}}/api/products?isActive=false

### Include active and discontinued products.
GET {{host}}/api/products?includeInactive=true

### Category deletion returns 409 while any product references it.
DELETE {{host}}/api/categories/{{categoryId}}

### Invalid product input returns 400.
POST {{host}}/api/products
Content-Type: application/json

{ "name": "Invalid", "price": -1, "currency": "USD", "categoryId": "{{categoryId}}" }

### Process liveness.
GET {{host}}/health/live

### Readiness requires PostgreSQL and applied migrations.
GET {{host}}/health/ready
