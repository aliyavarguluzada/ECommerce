{
  "profiles": {
    "http": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5171",
      "launchBrowser": true,
      "launchUrl": "swagger"
    },
    "https": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7136;http://localhost:5171",
      "launchBrowser": true,
      "launchUrl": "swagger"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "containerRunArguments": "--mount \"type=bind,source={ProjectDir}/../../security.local.json,target=/app/security.local.json,readonly\"",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "publishAllPorts": true,
      "useSSL": true,
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger"
    },
    "WSL": {
      "commandName": "WSL2",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7136;http://localhost:5171"
      },
      "distributionName": "",
      "launchBrowser": true,
      "launchUrl": "https://localhost:7136/swagger"
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}
